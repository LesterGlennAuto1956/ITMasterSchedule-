/* ---------- computations ---------- */
function schedOf(emp){return emp.schedule||DEFAULT_SCHED}
function regularFor(emp,date){const s=schedOf(emp)[JS_DAY[parse(date).getDay()]];return s&&s.start&&s.end?s:null}
function ptoType(id){const e=state.entries.find(x=>x.id===id);return e?e.type:"Time off"}
function allowanceOf(emp){return state.allowances.has(emp.id)?state.allowances.get(emp.id):0}
function dayStatus(emp,date){
  const aw=state.away.find(x=>x.employeeId===emp.id&&x.start<=date&&x.end>=date)||null;
  const pto=aw?{...aw,type:ptoType(aw.id)}:null;
  const ov=state.shiftMap.get(emp.id+"|"+date)||null;
  const hours=ov?(ov.off?null:{start:ov.start,end:ov.end}):regularFor(emp,date);
  const partial=!!pto&&!!pto.partial,out=!!pto&&!partial;
  const remote=state.remote.find(x=>x.employeeId===emp.id&&x.start<=date&&x.end>=date)||null;
  const dayLoc=state.locMap.get(emp.id+"|"+date);
  const loc=remote?"Remote":(dayLoc?dayLoc.location:(emp.location||""));
  return {pto,ov,hours,partial,out,remote,loc,locChanged:!!dayLoc,working:!!hours&&!out};
}
function workingNow(){
  const now=new Date(),t=iso(now),m=now.getHours()*60+now.getMinutes(),y=addDays(t,-1),res=[];
  for(const emp of sortedEmps()){
    const st=dayStatus(emp,t);
    if(st.working){const [a,b]=span(st.hours);if(m>=a&&m<b){res.push({emp,until:st.hours.end,remote:!!st.remote,loc:st.loc});continue}}
    const sy=dayStatus(emp,y);
    if(sy.working){const [a,b]=span(sy.hours);if(b>1440&&m<b-1440)res.push({emp,until:sy.hours.end,remote:!!sy.remote})}
  }
  return res;
}
function entriesForYear(y){return state.entries.filter(x=>x.start&&x.start.slice(0,4)===String(y))}
function outOn(d){return state.entries.filter(x=>x.start<=d&&x.end>=d&&empById(x.employeeId)&&ptoVisible(x.employeeId))}
function balanceFor(emp){
  const t=todayIso();let taken=0,sched=0;
  for(const x of entriesForYear(state.year)){if(x.employeeId!==emp.id)continue;const d=Number(x.days)||0;if(x.end<t)taken+=d;else sched+=d}
  const allow=Number(allowanceOf(emp))||0;return {allow,taken,sched,remaining:allow-taken-sched};
}

