    state.me=s.me;state.isAdmin=!!(s.me&&s.me.isManager);if(s.links)state.links=s.links;
    state.employees=s.employees||[];state.away=s.away||[];state.remote=s.remote||[];setShifts(s.shifts||[]);state.locMap=new Map((s.dayLocations||[]).map(x=>[x.employeeId+"|"+x.date,x]));state.projects=s.projects||[];state.inventory=s.inventory||[];state.viewers=s.viewers||[];state.monthReqs=s.monthRequests||[];state.orders=s.orders||[];state.signouts=s.signouts||[];state.slStatus=(s.equipmentStatus||{})["scissor-lift"]||null;
    state.entries=s.pto||(state.ptoMine?state.ptoMine.pto:[]);state.notify=s.notify||null;state.allowances=new Map(Object.entries(s.allowances||(state.ptoMine?state.ptoMine.allowances:{})||{}).map(([k,v])=>[k,Number(v)]));
    state.loaded=true;notice("");
    if(PAGE==="schedule"&&!state.hashDone&&location.hash==="#month-requests"){state.hashDone=true;history.replaceState(null,"",location.pathname);setTimeout(()=>$("mrOpen").click(),0)}
