/* ---------- dates & times ---------- */
function pad(n){return String(n).padStart(2,"0")}
function iso(d){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate())}
function parse(s){const [y,m,d]=s.split("-").map(Number);return new Date(y,m-1,d)}
function firstOfMonth(d){return new Date(d.getFullYear(),d.getMonth(),1)}
function todayIso(){return iso(new Date())}
function addDays(s,n){const d=parse(s);d.setDate(d.getDate()+n);return iso(d)}
function mondayOf(s){const d=parse(s);d.setDate(d.getDate()-(d.getDay()+6)%7);return iso(d)}
function isWeekday(d){const w=d.getDay();return w!==0&&w!==6}
function bizDays(s,e){if(!s||!e||e<s)return 0;let d=parse(s),end=parse(e),n=0;while(d<=end){if(isWeekday(d))n++;d.setDate(d.getDate()+1)}return n}
function fmtDate(s){return parse(s).toLocaleDateString(undefined,{month:"short",day:"numeric"})}
function longDate(s){return parse(s).toLocaleDateString(undefined,{weekday:"long",month:"long",day:"numeric"})}
function fmtRange(a,b){return a===b?fmtDate(a):fmtDate(a)+" – "+fmtDate(b)}
function fmtNum(n){return (Math.round(n*10)/10).toString()}
function toMin(t){const [h,m]=t.split(":").map(Number);return h*60+m}
function fmtTime(t){const [h,m]=t.split(":").map(Number);const o={hour:"numeric"};if(m)o.minute="2-digit";return new Date(2000,0,1,h,m).toLocaleTimeString(undefined,o)}
function fmtMin(m){m=((m%1440)+1440)%1440;return fmtTime(pad(Math.floor(m/60))+":"+pad(m%60))}
function fmtHours(h){return fmtTime(h.start)+" – "+fmtTime(h.end)}
function span(h){let a=toMin(h.start),b=toMin(h.end);if(b<=a)b+=1440;return [a,b]}
function durH(h){const [a,b]=span(h);return (b-a)/60}
state.calMonth=firstOfMonth(new Date());state.weekStart=mondayOf(todayIso());state.selDay=todayIso();state.miniMonth=firstOfMonth(new Date());state.projMonth=firstOfMonth(new Date());

